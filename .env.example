# MediCode Core Application
APP_NAME=MediCode
APP_ENV=development
APP_DEBUG=false
WEB_CONCURRENCY=2

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://medicode:replace-with-database-password@localhost:5432/medicode
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-password
MEDICODE_DB=medicode
MEDICODE_DB_USER=medicode
MEDICODE_DB_PASSWORD=replace-with-a-random-database-password

# Authentication (JWT)
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14

# Redis & Worker Queue (ARQ)
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=medicode:submissions
ARQ_MAX_JOBS=10
WORKER_CONCURRENCY=4

# Execution Sandbox & Judge0 Settings
EXECUTION_PROVIDER=judge0_self
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=medicode-judge0-secret-token
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_POLL_INTERVAL_SEC=0.1
JUDGE0_POLL_TIMEOUT_SEC=15.0
PYTHON_LANGUAGE_ID=71

# Sandbox Resource Limits (Per-submission defaults)
DEFAULT_CPU_TIME_LIMIT_SEC=1.0
DEFAULT_WALL_TIME_LIMIT_SEC=3.0
DEFAULT_MEMORY_LIMIT_KB=128000
DEFAULT_STACK_LIMIT_KB=64000
DEFAULT_MAX_PROCESSES=30
DEFAULT_MAX_FILE_SIZE_KB=1024
DEFAULT_ENABLE_NETWORK=false
MAX_SOURCE_CODE_BYTES=65536
MAX_OUTPUT_LENGTH_CHARS=2048

# Rate Limiting
RATE_LIMIT_SUBMISSION_REQUESTS=20
RATE_LIMIT_SUBMISSION_WINDOW_SEC=60
RATE_LIMIT_BURST_WINDOW_SEC=3
RATE_LIMIT_RUN_REQUESTS=10
RATE_LIMIT_RUN_WINDOW_SEC=60

# Caching & Cost Optimization
CACHE_RESULTS_ENABLED=true
CACHE_RESULTS_TTL_SEC=3600
EARLY_EXIT_ON_FAILURE=false

# Optional Tools & Admin UI
PGADMIN_DEFAULT_EMAIL=admin@medicode.example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-random-pgadmin-password
